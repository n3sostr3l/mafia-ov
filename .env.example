# Copy to .env and replace the password with a long random value.
DATABASE_PASSWORD=replace-with-a-long-random-password
PUBLIC_URL=http://localhost:8088
COOKIE_SECURE=false
# Default SMTP is the local Mailpit service. Open http://localhost:8025 to confirm email.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=studio@localhost
